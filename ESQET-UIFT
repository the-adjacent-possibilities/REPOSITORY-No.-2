 * @dev ERC721A Contract implementing EIP-712 Lazy Minting based on ESQET Coherence Signatures.
 */
contract ESQETQHNFT is ERC721A, Ownable, EIP712 {
    using ECDSA for bytes32;

    address public signerAddress;
    
    // Struct matching the EIP-712 structure used in the off-chain server
    struct LazyMintVoucher {
        uint256 tokenId;
        uint256 price;
        address minterAddress;
        string tokenURI;
    }
    
    // Store metadata for verification/retrieval
    mapping(uint256 => uint256) public tokenPrice;
    mapping(uint256 => string) public tokenURI;

    /**
     * @dev Constructor initializes the contract with the EIP-712 domain (name, version)
     * and sets the address authorized to sign minting vouchers.
     */
    constructor(address _signerAddress) ERC721A("ESQET QH-NFT", "QHNT") 
        EIP712("QuantumHolographicNFT", "1") 
        Ownable(msg.sender) 
    {
        signerAddress = _signerAddress;
    }

    /**
     * @dev Allows a user to redeem a signed voucher for a token (lazy mint).
     * @param voucher The LazyMintVoucher struct containing minting parameters.
     * @param signature The EIP-712 signature generated by the off-chain signer.
     */
    function lazyMint(LazyMintVoucher calldata voucher, bytes calldata signature) public payable {
        // 1. Verify Signature
        address recoveredSigner = _verifyVoucher(voucher, signature);
        require(recoveredSigner == signerAddress, "Invalid signer: Signature verification failed.");
        
        // 2. Verify Payment and Sender
        require(msg.value >= voucher.price, "Insufficient payment: Required price not met.");
        require(voucher.minterAddress == msg.sender, "Unauthorized minter: Voucher not intended for this address.");
        
        // 3. Verify Token Status
        require(!_exists(voucher.tokenId), "Token exists: This TokenID has already been minted.");

        // 4. Mint Token and Record Metadata
        _safeMint(msg.sender, voucher.tokenId);
        tokenPrice[voucher.tokenId] = voucher.price;
        tokenURI[voucher.tokenId] = voucher.tokenURI;
        
        // Optional: Send difference back to minter if they overpaid
        if (msg.value > voucher.price) {
            payable(msg.sender).transfer(msg.value - voucher.price);
        }
    }

    /**
     * @dev Computes the EIP-712 hash for the voucher and recovers the signer address.
     */
    function _verifyVoucher(LazyMintVoucher calldata voucher, bytes calldata signature) 
        internal view returns (address) 
    {
        // 1. Compute the structural hash for the LazyMintVoucher struct
        bytes32 structHash = keccak256(abi.encode(
            keccak256("LazyMintVoucher(uint256 tokenId,uint256 price,address minterAddress,string tokenURI)"),
            voucher.tokenId,
            voucher.price,
            voucher.minterAddress,
            keccak256(bytes(voucher.tokenURI)) // URI is hashed as per EIP-712 spec for strings
        ));
        
        // 2. Compute the final EIP-712 digest
        bytes32 digest = _hashTypedDataV4(structHash);
        
        // 3. Recover the address from the signature
        return digest.recover(signature);
    }

    // Override to ensure the correct domain separator calculation
    function _hashTypedDataV4(bytes32 structHash) internal view virtual override returns (bytes32) {
        return keccak256(abi.encodePacked("\x19\x01", _domainSeparatorV4(), structHash));
    }
    
    // Standard ERC721 function to retrieve the token URI
    function tokenURI(uint256 tokenId) public view virtual override returns (string memory) {
        require(_exists(tokenId), "ERC721Metadata: URI query for nonexistent token");
        return tokenURI[tokenId];
    }
}
