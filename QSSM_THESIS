            if n_jets > 0:
                jet_pts.extend(jets[:n_jets])
            
            multiplicity = n_jets
            met = np.random.exponential(35) + 15  # pileup + unclustered
            
            multiplicities.append(multiplicity)
            mets.append(met)

        return np.array(jet_pts), np.array(multiplicities), np.array(mets)

